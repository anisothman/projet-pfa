# API keys — fill in before running
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
SERP_API_KEY=...

# LLM routing: primary provider, fallback triggers on quota / rate-limit errors
LLM_PRIMARY=openai           # openai | gemini
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# Storage
REPORTS_DIR=./reports

# Observability
LOG_LEVEL=INFO
LOG_JSON=false

# HTTP
CORS_ORIGINS=http://localhost:3000
